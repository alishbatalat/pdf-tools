{
  "name": "pdf-tools-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Node.js backend for pdf-tools: local AI (summarize/translate/chat) and document conversion, no third-party API keys.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./server.js --watch-path=./src server.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.9.1",
    "multer": "^2.4.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.2",
    "word-extractor": "^1.0.4"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.6": true
  }
}
