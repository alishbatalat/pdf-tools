# Copy this file to .env.local and adjust if needed.
# No third-party API keys required — AI and conversion tools are served by
# the self-hosted backend in ../backend (see its README for setup).

# Base URL of the backend service. Defaults to http://localhost:4000 if unset.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Google sign-in (optional — without these, "Sign in with Google" errors out,
# but every tool still works for signed-out visitors; there's just no history).
# Get these from https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Import from Google Drive" button on every file tool (optional — without
# these, the button just doesn't render; local upload and drag-and-drop
# still work everywhere).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is the same value as GOOGLE_CLIENT_ID above —
# it's not secret, it just also needs to be reachable from the browser.
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY: console.cloud.google.com/apis/credentials
# -> Create Credentials -> API key -> restrict it to the "Google Picker API"
# (enable that API under "Library" first if it isn't already).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
